// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


enum PlayerSymbol {
  X
  O
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  ABANDONED
  CANCELLED
}

enum MatchWinner {
  PLAYER_X
  PLAYER_O
}

enum GameMode {
  LOCAL
  ONLINE
  NBOT
  PBOT
}

enum GameType {
  CLASSIC
  CUSTOM
  RANKED
  CASUAL
}

enum RatingType {
  RANKED_3X3
  RANKED_4X4
  RANKED_5X5
  RANKED_6X6
}

model User {
  id                String   @id @default(cuid())

  username          String   @unique
  displayName       String?
  usernameChangedAt   DateTime?

  email             String   @unique
  passwordHash      String?

  provider          AuthProvider @default(LOCAL)
  providerId        String?

  avatar            String?
  bio               String?

  isEmailVerified   Boolean  @default(false)
  emailVerifiedAt   DateTime?

  isActive          Boolean  @default(true)
  lastLoginAt       DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions          Session[]
  Participants      Participant[]
  settings          UserSettings?
  stats             UserStats?
  ratings           UserRating[]

  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]

  @@unique([provider, providerId])
  @@index([username])
  @@index([email])
}

model Session {
  id                String   @id @default(cuid())

  refreshTokenHash  String   @unique

  ipAddress         String?
  userAgent         String?

  expiresAt         DateTime
  lastUsedAt        DateTime @default(now())

  isRevoked         Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId            String
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}


model VerificationToken {
  id          String   @id @default(cuid())

  tokenHash   String   @unique

  expiresAt   DateTime

  createdAt   DateTime @default(now())

  userId      String   @unique

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id         String   @id @default(cuid())

  tokenHash  String   @unique

  expiresAt  DateTime
  createdAt  DateTime @default(now())

  userId     String   @unique
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Match {
  id               String        @id @default(cuid())

  status           MatchStatus   @default(WAITING)
  result           MatchWinner?

  gameMode         GameMode
  gameType         GameType

  // Game Configuration
  boardSize        Int
  winLength        Int
  maxActivePieces  Int
  reclaimTokens    Int

  // Timing
  startedAt        DateTime?
  endedAt          DateTime?
  durationMs       Int?

  // Metadata
  totalMoves       Int           @default(0)
  isRated          Boolean       @default(false)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  participants      Participant[]
  moves            Move[]

  isPrivate Boolean @default(false)

  @@index([status])
  @@index([gameMode])
  @@index([gameType])
  @@index([createdAt])
}


model Participant {
  id                String   @id @default(cuid())

  // Relations
  matchId           String
  userId            String?

  // Guest Support
  guestName         String?

  // Gameplay
  symbol            PlayerSymbol
  isWinner          Boolean @default(false)

  // Rating
  ratingBefore      Int?
  ratingAfter       Int?
  ratingChange      Int?

  joinedAt          DateTime @default(now())
  isDeleted         Boolean  @default(false)

  match             Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user              User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  moves Move[]

  @@unique([matchId, symbol])
  @@index([matchId])
  @@index([userId])
}

model Move {
  id              String   @id @default(cuid())

  moveNumber      Int

  row             Int
  column          Int

  removedRow      Int?
  removedColumn   Int?

  createdAt       DateTime @default(now())

  matchId         String
  playerId        String

  match           Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participant           Participant @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, moveNumber])

  @@index([matchId])
}


model UserSettings {
  id                  String   @id @default(cuid())

  // Appearance
  theme               String   @default("system")
  boardTheme          String   @default("classic")

  // Audio
  soundEnabled        Boolean  @default(true)
  musicEnabled        Boolean  @default(true)

  // Gameplay
  showCoordinates     Boolean  @default(true)
  showMoveHistory     Boolean  @default(true)
  animationsEnabled   Boolean  @default(true)

  // Language
  language            String   @default("en")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  userId              String   @unique
  user                User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserStats {
  id                 String   @id @default(cuid())

  // Overall
  gamesPlayed        Int @default(0)
  wins               Int @default(0)
  losses             Int @default(0)

  // Streak
  currentStreak      Int @default(0)
  longestStreak      Int @default(0)

  // Performance
  totalMoves         Int @default(0)
  totalPlayTimeMs    BigInt @default(0)

  // Activity
  lastPlayedAt       DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userId             String @unique
  user               User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRating {
  id            String   @id @default(cuid())

  type          RatingType

  rating        Int      @default(1000)
  peakRating    Int      @default(1000)

  gamesPlayed   Int      @default(0)
  wins          Int      @default(0)
  losses        Int      @default(0)

  lastPlayedAt  DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])

  @@index([type])
  @@index([rating])
}