# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Neon / PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT Authentication
JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Cookie Configuration
COOKIE_MAX_AGE=2592000000
# COOKIE_SAME_SITE="none" # Optional: "none" (default in production) or "lax"

# Socket Grace Periods (ms)
SOCKET_FORFEIT_GRACE_MS=10000
SOCKET_CLEANUP_GRACE_MS=30000

# Email Configuration (Brevo)
BREVO_API_KEY="your_brevo_api_key_here"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="noreply@example.com"
EMAIL_FROM_NAME="Zekros"

# CORS & App Configuration
FRONTEND_URL="http://localhost:8080"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"
